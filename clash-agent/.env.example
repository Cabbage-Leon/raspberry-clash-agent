# LLM配置

# 是否启用本地LLM（Ollama）
LOCAL_LLM_ENABLED=true
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2:1.8b

# DeepSeek API配置（可选）
# DEEPSEEK_API_KEY=your-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 推理参数
MAX_TOKENS=2048

# ==================== Clash配置（基于nelvko/clash-for-linux-install）====================

# 服务名称（mihomo 或 clash）
CLASH_SERVICE_NAME=mihomo

# clashctl命令路径（默认已加入PATH）
CLASHCTL_PATH=clashctl

# 面板配置
DASHBOARD_PORT=9090
DASHBOARD_PATH=/usr/local/clash/dashboard

# 订阅配置
CLASH_CONFIG_DIR=/etc/clash
CLASH_RUNTIME_CONFIG=/etc/clash/config.yaml
CLASH_MIXIN_CONFIG=/etc/clash/mixin.yaml

# 命令超时（秒）
CLASH_COMMAND_TIMEOUT=30

# ==================== ReAct配置 ====================
MAX_ITERATIONS=10
TIMEOUT_PER_STEP=30
EARLY_STOP_ON_FAILURE=true

# ==================== 记忆系统配置 ====================
MAX_CONVERSATION_TURNS=10
SIMILARITY_THRESHOLD=0.7

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
